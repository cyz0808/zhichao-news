# 中文翻译：推荐 DeepSeek（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 也可以改用 OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# 个人微信推送：登录 https://sct.ftqq.com/sendkey 获取
SERVERCHAN_SENDKEY=

# 企业微信群机器人推送（可选）
WECOM_WEBHOOK_URL=

# 每日简报
DIGEST_HOUR=8
TIMEZONE=Asia/Shanghai
DIGEST_SIZE=15

# AI 主编复审：默认开启；想节省 API 时改为 0
EDITORIAL_AI=1
EDITORIAL_CANDIDATE_SIZE=36
MIN_DIGEST_SCORE=52

# X 线索层：需要 X Developer Bearer Token；没有密钥时会自动跳过
X_SIGNALS_ENABLED=1
X_BEARER_TOKEN=
X_ACCOUNTS=OpenAI,AnthropicAI,NVIDIA,AMD,Microsoft,Google,Meta,Tesla
X_KEYWORDS="AI data center" investment|"export control" semiconductor|"power grid" data center|"GPU" supply chain|"central bank" inflation|"China" semiconductor|"nuclear" power data center|"electricity demand" AI
X_MAX_RESULTS=10
X_MIN_CREDIBILITY=65
